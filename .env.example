# Database connection string (PostgreSQL via Docker)
# Runs as: docker compose up -d postgres
DATABASE_URL=postgresql://ants:ants-dev-password@localhost:5432/ants

# Base URL for Ollama (local LLM provider)
OLLAMA_BASE_URL=http://localhost:11434

# Secret key for JWT / session signing
JWT_SECRET=change-me-to-a-random-string

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# Graceful shutdown timeout in seconds (default: 30)
SHUTDOWN_TIMEOUT_SECONDS=30

# ─── First-time setup credentials (used by bun run setup:db) ─────────────
# Override these to customize the admin account
# SETUP_EMAIL=admin@ants.local
# SETUP_PASSWORD=ants-admin-123
# SETUP_NAME=Admin User
