# Database connection string (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/ants

# Ollama server base URL (local inference only)
OLLAMA_BASE_URL=http://localhost:11434

# Secret for bcrypt hashing of API keys
API_KEY_SECRET=change-me-to-a-random-secret

# Secret for JWT signing (interactive sessions)
JWT_SECRET=change-me-to-a-random-secret

# Log level: debug, info (default), warn, error
LOG_LEVEL=info

# Graceful shutdown timeout in seconds (default 30)
SHUTDOWN_TIMEOUT_SECONDS=30
