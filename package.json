{
  "name": "ants",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --watch packages/api/src/index.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "spec:bundle": "bun run scripts/bundle-spec.ts",
    "spec:validate": "bun run scripts/bundle-spec.ts && npx @redocly/cli lint openapi/bundled.yaml",
    "spec:types": "bun run scripts/bundle-spec.ts && npx openapi-typescript openapi/bundled.yaml -o packages/core/src/types/api.d.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@redocly/cli": "2.32.0",
    "@types/bun": "1.3.13",
    "drizzle-kit": "^0.31.0",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "yaml": "2.7.1"
  }
}
